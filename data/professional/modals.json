  "theory": {
    "summary": "Los modales y auxiliares modifican o apoyan al verbo principal.",
    "rules": [
      "Los modales preceden a la forma base.",
      "Los auxiliares forman preguntas y negaciones."
    ],
    "examples": [
      "I can help.",
      "Do you work here?"
    ]
  },
